@model IEnumerable<Doctor>
@{ ViewData["Title"] = "Home"; }
<section class="hero rounded-4 p-5 mb-5"><div class="row align-items-center"><div class="col-lg-8"><span class="badge bg-info text-dark mb-3">Your health, our priority</span><h1 class="display-5 fw-bold">Book your doctor appointment with ease.</h1><p class="lead">Find trusted doctors and book a convenient appointment in just a few steps.</p><a class="btn btn-primary btn-lg" asp-controller="Appointments" asp-action="Book">Book an Appointment</a></div><div class="col-lg-4 text-center display-1">＋</div></div></section>
<h2 class="mb-3">Our Available Doctors</h2><div class="row g-4">@foreach(var d in Model){<div class="col-md-6 col-lg-4"><div class="card h-100 shadow-sm"><div class="card-body"><div class="doctor-icon mb-3">＋</div><h5 class="card-title">Dr. @d.FullName</h5><p class="text-primary fw-semibold">@d.Specialization</p><p>@d.ExperienceYears years experience</p><p class="mb-3">Consultation fee: ₹@d.ConsultationFee.ToString("0.00")</p>@if(User.Identity?.IsAuthenticated == true){<a class="btn btn-outline-primary" asp-controller="Appointments" asp-action="Book">Book appointment</a>}else{<a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Login to book</a>}</div></div></div>}@if(!Model.Any()){<p>No doctors have been added yet. An administrator can add doctors after logging in.</p>}</div>
