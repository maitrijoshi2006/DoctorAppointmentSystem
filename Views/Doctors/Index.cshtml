@model IEnumerable<Doctor>
@{ ViewData["Title"] = "Manage Doctors"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Manage Doctors</h2><a asp-action="Create" class="btn btn-primary">Add Doctor</a></div><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Name</th><th>Specialization</th><th>Experience</th><th>Fee</th><th>Available</th><th>Actions</th></tr></thead><tbody>@foreach(var d in Model){<tr><td>Dr. @d.FullName</td><td>@d.Specialization</td><td>@d.ExperienceYears years</td><td>₹@d.ConsultationFee</td><td>@(d.IsAvailable ? "Yes" : "No")</td><td><a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-outline-primary">Edit</a> <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this doctor?')"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div>
