@{ ViewData["Title"] = "Admin Dashboard"; }
<h2 class="mb-4">Administrator Dashboard</h2><div class="row g-3 mb-4"><div class="col-sm-6 col-lg-3"><div class="stat-card"><span>Doctors</span><strong>@ViewBag.Doctors</strong><a asp-controller="Doctors" asp-action="Index">Manage doctors →</a></div></div><div class="col-sm-6 col-lg-3"><div class="stat-card"><span>Registered users</span><strong>@ViewBag.Patients</strong></div></div><div class="col-sm-6 col-lg-3"><div class="stat-card"><span>Total appointments</span><strong>@ViewBag.Appointments</strong><a asp-controller="Appointments" asp-action="Index">View appointments →</a></div></div><div class="col-sm-6 col-lg-3"><div class="stat-card"><span>Pending appointments</span><strong>@ViewBag.Pending</strong></div></div></div><div class="d-flex justify-content-between"><h4>Recent appointments</h4><a asp-controller="Appointments" asp-action="Index">View all</a></div><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Status</th></tr></thead><tbody>@foreach(Appointment a in ViewBag.Recent){<tr><td>@a.Patient?.FullName</td><td>Dr. @a.Doctor?.FullName</td><td>@a.AppointmentDate.ToString("dd MMM yyyy")</td><td>@a.AppointmentTime</td><td>@a.Status</td></tr>}</tbody></table></div>
