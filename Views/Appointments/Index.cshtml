@model IEnumerable<Appointment>
@{ ViewData["Title"] = "Appointments"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>@(User.IsInRole("Admin") ? "All Appointments" : "My Appointments")</h2>@if(!User.IsInRole("Admin")){<a asp-action="Book" class="btn btn-primary">Book Appointment</a>}</div><div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th>Time</th><th>Reason</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@(a.Patient?.FullName ?? "Patient")</td><td>Dr. @(a.Doctor?.FullName ?? "Unavailable")</td><td>@a.AppointmentDate.ToString("dd MMM yyyy")</td><td>@a.AppointmentTime</td><td>@a.Reason</td><td><span class="badge @(a.Status == "Confirmed" ? "bg-success" : a.Status == "Cancelled" ? "bg-danger" : a.Status == "Completed" ? "bg-secondary" : "bg-warning text-dark")">@a.Status</span></td><td>@if(a.Status != "Cancelled" && a.Status != "Completed"){if(User.IsInRole("Admin")){<form asp-action="SetStatus" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@a.Id"/><select name="status" class="form-select form-select-sm"><option selected="@(a.Status == "Pending")">Pending</option><option selected="@(a.Status == "Confirmed")">Confirmed</option><option selected="@(a.Status == "Completed")">Completed</option><option>Cancelled</option></select><button class="btn btn-sm btn-primary">Update</button></form>}else{<form asp-action="Cancel" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Cancel this appointment?')"><button class="btn btn-sm btn-outline-danger">Cancel</button></form>}}</td></tr>}</tbody></table></div>@if(!Model.Any()){<p>No appointments found.</p>}
